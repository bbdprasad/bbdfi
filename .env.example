# Local development works with no settings at all (SQLite + sample prices + handle-only sign-in).

# Supabase: Project Settings > Database > Connection string (use the "Transaction pooler" URI,
# and change the scheme to postgresql+psycopg://)
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase: Project Settings > API. Setting SUPABASE_URL turns on real email sign-in.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon public key>
# Only needed for projects still on the legacy JWT secret. Leave unset to use JWKS signing keys.
# SUPABASE_JWT_SECRET=

# Protects POST /api/admin/run-daily for an external cron service.
# ADMIN_TOKEN=<long random string>

# nifty50 (default) or all
# UNIVERSE=nifty50
